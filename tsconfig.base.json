{
    "compilerOptions": {
        "module": "es2022",
        "moduleResolution": "bundler",
        "target": "es2022",
        "lib": [
            "es2022",
            "es2024.promise",
        ],
        "types": [
            "node"
        ],
        "sourceMap": true,
        "strict": true,
        "incremental": true,
        "declaration": true,
        "declarationMap": true,
    },
    "exclude": [
        "**/node_modules",
        "**/dist",
    ],
}
