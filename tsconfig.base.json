{
    "compilerOptions": {
        "module": "es2022",
        "moduleResolution": "bundler",
        "target": "ESNext",
        "lib": [
            "ESNext",
        ],
        "types": [
            "node",
            "mocha",
            // chai-as-promised augments the global Chai.Assertion interface, and
            // this array disables automatic @types discovery, so it has to be
            // listed for `rejectedWith` and friends to typecheck. Registered at
            // runtime by @microsoft/vscode-azext-eng.
            "chai-as-promised",
        ],
        "sourceMap": true,
        "strict": true,
        "noImplicitOverride": true,
        "verbatimModuleSyntax": true,
        "incremental": true,
        "declaration": true,
        "declarationMap": true,
    },
    "exclude": [
        "**/node_modules",
        "**/dist",
        "**/testProjects",
    ],
}
