{
    "compilerOptions": {
        "module": "es2022",
        "moduleResolution": "bundler",
        "target": "es2024",
        "lib": [
            "es2024",
        ],
        "types": [
            "node",
            "mocha",
        ],
        "sourceMap": true,
        "strict": true,
        "noImplicitOverride": true,
        "verbatimModuleSyntax": true,
        "incremental": true,
        "declaration": true,
        "declarationMap": true,
    },
    "exclude": [
        "**/node_modules",
        "**/dist",
        "**/testProjects",
    ],
}
