{
    "name": "@microsoft/vscode-azure-monorepo",
    "version": "0.0.0",
    "private": true,
    "description": "Azure for Visual Studio Code",
    "homepage": "https://github.com/microsoft/vscode-azure#readme",
    "bugs": {
        "url": "https://github.com/microsoft/vscode-azure/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/microsoft/vscode-azure.git"
    },
    "license": "MIT",
    "author": "Microsoft Corporation",
    "scripts": {
        "postinstall": "node ./scripts/postinstall.mjs",
        "lint": "pnpm -r --parallel run lint",
        "build": "pnpm -r run build",
        "package": "pnpm -r --parallel run package",
        "test": "pnpm -r run test",
        "clean": "pnpm -r --parallel run clean",
        "link-test-cache": "azext-link-test-cache --extension-dir ./extensions/vscode-azure --replace",
        "all": "pnpm clean && pnpm lint && pnpm build && pnpm package && pnpm test"
    },
    "packageManager": "pnpm@11.8.0",
    "engines": {
        "node": ">=24",
        "vscode": "^1.123.0"
    },
    "devDependencies": {
        "@microsoft/vscode-azext-eng": "^1.2.0",
        "@types/node": "~24",
        "@types/vscode": "1.120.0",
        "@typescript/native": "npm:typescript@7.0.2"
    }
}
