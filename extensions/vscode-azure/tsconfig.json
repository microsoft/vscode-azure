{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "../..",
        "outDir": "./dist/esm",
        "paths": {
            // These cause files in these packages to be resolved correctly by the linter and type checker
            "@microsoft/vscode-azure-azutils": [
                "../../packages/azutils/src/index.ts"
            ],
            "@microsoft/vscode-azure-utils": [
                "../../packages/utils/src/index.ts"
            ],
            "@microsoft/vscode-azure-azutils/testing": [
                "../../packages/azutils/test/testing.ts"
            ],
            "@microsoft/vscode-azure-utils/testing": [
                "../../packages/utils/test/testing.ts"
            ],
        },
        "experimentalDecorators": true,
    },
    "exclude": [
        "**/node_modules",
        "**/dist",
        "**/testProjects",
        // Type-checked separately by `test/ui/tsconfig.json`, which adds the DOM lib Playwright needs.
        "test/ui",
        "playwright.config.ts",
    ],
}
