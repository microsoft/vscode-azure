targetScope = 'subscription'

@minLength(1)
@maxLength(48)
@description('Name of the azd environment.')
param environmentName string

@minLength(1)
@description('Azure region for all resources.')
param location string

@description('The SKU of the App Service Plan that hosts the Function App (e.g. FC1, EP1, S1).')
param appServicePlanSkuName string = 'FC1'

@description('The runtime stack of the Function App (e.g. dotnet-isolated, node, python).')
param functionWorkerRuntime string = 'dotnet-isolated'

@description('The version of the language runtime stack (e.g. 20 for Node 20, 3.11 for Python 3.11).')
param runtimeVersion string = ''

@description('Value applied as the `azd-service-name` tag on the Function App so `azd deploy` can target it.')
param azdServiceName string = 'myfunc'

var tags = { 'azd-env-name': environmentName }

// Tag the Function App (only) with `azd-service-name` so `azd deploy` can target it.
var functionAppTags = { 'azd-service-name': azdServiceName }

resource rg 'Microsoft.Resources/resourceGroups@2024-03-01' = {
  name: 'rg-${environmentName}'
  location: location
  tags: tags
}

// TODO: The pattern module is temporarily at https://github.com/bwateratmsft/bicep-registry-modules
// Publish using the command: `az bicep publish --file .\avm\ptn\web\function-app\main.bicep --target br:bwaterpretendavm.azurecr.io/bicep/function-app:<version>`
module functionApp 'br:bwaterpretendavm.azurecr.io/bicep/function-app:0.1.0' = {
  scope: rg
  name: 'functionApp'
  params: {
    functionAppName: '${environmentName}-func'
    appServicePlanSkuName: appServicePlanSkuName
    functionWorkerRuntime: functionWorkerRuntime
    runtimeVersion: runtimeVersion
    tags: tags
    functionAppTags: functionAppTags
    autoGeneratedDomainNameLabelScope: 'TenantReuse'
    corsAllowedOrigins: ['https://portal.azure.com']
  }
}
