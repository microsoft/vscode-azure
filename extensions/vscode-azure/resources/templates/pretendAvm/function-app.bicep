// Published to: br:bwaterpretendavm.azurecr.io/bicep/function-app
// Current version: 0.1.11
// To publish:
//   az bicep publish \
//     --file extensions/vscode-azure/resources/templates/pretendAvm/function-app.bicep \
//     --target br:bwaterpretendavm.azurecr.io/bicep/function-app:<version>

targetScope = 'resourceGroup'

// Parameters

@minLength(3)
@description('Globally unique name for the function app.')
param functionAppName string

@description('Azure region for all resources.')
param location string = resourceGroup().location

@description('Hosting plan.')
@allowed(['FlexConsumption', 'Premium', 'AppServicePlan'])
param hostingPlan string = 'FlexConsumption'

@description('Runtime version string (e.g. "Node|20", "Python|3.11"). Used as linuxFxVersion on Linux.')
param runtimeVersion string = 'Node|20'

@description('Operating system. Flex Consumption always uses Linux regardless of this value.')
@allowed(['linux', 'windows'])
param operatingSystem string = 'linux'

@description('[Flex Consumption] Instance memory in MB.')
@allowed([512, 1024, 2048, 4096])
param flexInstanceMemoryMB int = 2048

@description('[Flex Consumption] Maximum instance count for auto-scale.')
@minValue(1)
@maxValue(1000)
param flexMaximumInstanceCount int = 100

@description('[Premium] Elastic Premium SKU.')
@allowed(['EP1', 'EP2', 'EP3'])
param premiumSkuName string = 'EP1'

@description('[App Service Plan] Dedicated plan SKU.')
param appServicePlanSkuName string = 'S1'

@description('Tags applied to every resource.')
param tags object = {}

@description('Additional tags applied to the Function App only (merged with `tags`). Use this for tags that must target the Function App but not its supporting resources, e.g. `azd-service-name`.')
param functionAppTags object = {}

@description('Scope of uniqueness for the default hostname. Omit or set to null for legacy behavior.')
param autoGeneratedDomainNameLabelScope string?

@description('CORS allowed origins for the Function App. Empty array disables CORS.')
param corsAllowedOrigins string[] = []

@description('Whether CORS requests with credentials are allowed.')
param corsSupportCredentials bool = false

// Derived flags

var runtimeStack = toLower(split(runtimeVersion, '|')[0])
var isLinux = operatingSystem == 'linux' || hostingPlan == 'FlexConsumption'
var isFlex = hostingPlan == 'FlexConsumption'
var isPremium = hostingPlan == 'Premium'
var isAppServicePlan = hostingPlan == 'AppServicePlan'

// Naming

var storageAccountName = take(padLeft(toLower(replace('st${functionAppName}', '-', '')), 3, '0'), 24)
var functionAppKind = isLinux ? 'functionapp,linux' : 'functionapp'
// Deployment blob container used by Flex Consumption. Must match the URL embedded in
// functionAppConfig.deployment.storage.value so azd / the Functions host can find it.
var deploymentContainerName = 'app-package-${take(toLower(functionAppName), 32)}-${uniqueString(resourceGroup().id)}'

// Tags applied to the Function App: caller-supplied `tags` merged with Function-App-specific
// `functionAppTags` (e.g. `azd-service-name`). Other resources (storage, plan, etc.) receive
// `tags` only.
var mergedFunctionAppTags = union(tags, functionAppTags)

// SKU mapping

var planSkuName = isFlex ? 'FC1' : isPremium ? premiumSkuName : appServicePlanSkuName

// Flex Consumption expects just the version number (e.g. '20'), not the linuxFxVersion format ('Node|20')
var flexRuntimeVersion = contains(runtimeVersion, '|') ? split(runtimeVersion, '|')[1] : runtimeVersion

// Storage connection helpers

var storageEndpointSuffix = environment().suffixes.storage
var storageConnectionString = 'DefaultEndpointsProtocol=https;AccountName=${storageAccount.name};EndpointSuffix=${storageEndpointSuffix};AccountKey=${storageAccount.listKeys().keys[0].value}'

// App settings

var runtimeAppSettings = isFlex
  ? {}
  : {
      FUNCTIONS_EXTENSION_VERSION: '~4'
      FUNCTIONS_WORKER_RUNTIME: runtimeStack
    }

var contentSettings = isPremium
  ? {
      WEBSITE_CONTENTAZUREFILECONNECTIONSTRING: storageConnectionString
      WEBSITE_CONTENTSHARE: toLower(functionAppName)
    }
  : {}

// Flex Consumption: the Functions host reads AzureWebJobsStorage via the user-assigned
// managed identity. AVM's site module sets `storageAccountUseIdentityAuthentication: true`
// on the appsettings config, but on Flex the host also needs these two explicit settings
// to pick the right identity. Without them the host falls back to connection-string auth
// and triggers-sync / deployment package reads fail.
var miStorageAuthSettings = isFlex
  ? {
      AzureWebJobsStorage__clientId: managedIdentity.outputs.clientId
      AzureWebJobsStorage__credential: 'managedidentity'
    }
  : {}

var deploymentStorageSettings = isFlex ? {} : {}

var runFromPackageSettings = (!isLinux)
  ? {
      WEBSITE_RUN_FROM_PACKAGE: '1'
    }
  : {}

var javaAgentSettings = (isPremium && runtimeStack == 'java')
  ? {
      APPLICATIONINSIGHTS_ENABLE_AGENT: 'true'
    }
  : {}

var customAppSettings = union(
  runtimeAppSettings,
  contentSettings,
  deploymentStorageSettings,
  runFromPackageSettings,
  javaAgentSettings,
  miStorageAuthSettings
)

// Site config

var corsConfig = empty(corsAllowedOrigins)
  ? {}
  : {
      cors: {
        allowedOrigins: corsAllowedOrigins
        supportCredentials: corsSupportCredentials
      }
    }

var siteConfig = union(
  { alwaysOn: isAppServicePlan, use32BitWorkerProcess: false },
  (isLinux && !isFlex) ? { linuxFxVersion: runtimeVersion } : {},
  corsConfig
)

// ===========================================================================
// Resources
// ===========================================================================

// Storage Account
resource storageAccount 'Microsoft.Storage/storageAccounts@2023-05-01' = {
  name: storageAccountName
  location: location
  kind: 'StorageV2'
  sku: { name: 'Standard_LRS' }
  properties: {
    supportsHttpsTrafficOnly: true
    defaultToOAuthAuthentication: true
    allowSharedKeyAccess: !isFlex
    minimumTlsVersion: 'TLS1_2'
  }
  tags: tags
}

// Deployment blob container used by Flex Consumption for the zipped app package.
// The container name must match the URL in functionAppConfig.deployment.storage.value
// (both derived from `deploymentContainerName`).
resource blobService 'Microsoft.Storage/storageAccounts/blobServices@2023-05-01' = if (isFlex) {
  parent: storageAccount
  name: 'default'
}
resource deploymentContainer 'Microsoft.Storage/storageAccounts/blobServices/containers@2023-05-01' = if (isFlex) {
  parent: blobService
  name: deploymentContainerName
  properties: {
    publicAccess: 'None'
  }
}

// Storage Blob Data Owner role assignment. When using identity-based auth on Flex
// Consumption (per AVM web/site docs: `storageAccountUseIdentityAuthentication: true`
// requires 'Storage Blob Data Owner' at minimum), the Functions host needs Owner-level
// access on the storage account to manage the deployment package container.
resource storageRoleAssignment 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(storageAccount.id, 'StorageBlobDataOwner', functionAppName)
  scope: storageAccount
  properties: {
    roleDefinitionId: subscriptionResourceId(
      'Microsoft.Authorization/roleDefinitions',
      'b7e6dc6d-f1e8-4753-8033-0f276bb0955b'
    )
    principalId: managedIdentity.outputs.principalId
    principalType: 'ServicePrincipal'
  }
}

// Log Analytics Workspace
module logAnalyticsWorkspace 'br/public:avm/res/operational-insights/workspace:0.11.0' = {
  name: 'logAnalytics-${uniqueString(resourceGroup().id, functionAppName)}'
  params: {
    name: 'log-${functionAppName}'
    location: location
    tags: tags
  }
}

// Application Insights
module appInsights 'br/public:avm/res/insights/component:0.6.0' = {
  name: 'appInsights-${uniqueString(resourceGroup().id, functionAppName)}'
  params: {
    name: 'appi-${functionAppName}'
    location: location
    kind: 'web'
    applicationType: 'web'
    workspaceResourceId: logAnalyticsWorkspace.?outputs.?resourceId ?? ''
    tags: tags
  }
}

// User-Assigned Managed Identity
module managedIdentity 'br/public:avm/res/managed-identity/user-assigned-identity:0.4.0' = {
  name: 'managedIdentity-${uniqueString(resourceGroup().id, functionAppName)}'
  params: {
    name: 'id-${functionAppName}'
    location: location
    tags: tags
  }
}

// App Service Plan
module appServicePlan 'br/public:avm/res/web/serverfarm:0.4.0' = {
  name: 'appServicePlan-${uniqueString(resourceGroup().id, functionAppName)}'
  params: {
    name: isFlex ? 'FLEX-${functionAppName}' : 'ASP-${functionAppName}'
    location: location
    kind: isLinux ? 'linux' : 'app'
    skuName: planSkuName
    tags: tags
  }
}

// Function App
module functionApp 'br/public:avm/res/web/site:0.22.0' = {
  name: 'functionApp-${uniqueString(resourceGroup().id, functionAppName)}'
  params: {
    name: functionAppName
    location: location
    kind: functionAppKind
    serverFarmResourceId: appServicePlan.outputs.resourceId
    tags: mergedFunctionAppTags
    clientAffinityEnabled: false
    httpsOnly: true
    siteConfig: siteConfig
    managedIdentities: {
      userAssignedResourceIds: [managedIdentity.outputs.resourceId]
    }
    functionAppConfig: isFlex
      ? {
          deployment: {
            storage: {
              type: 'blobContainer'
              value: '${storageAccount.properties.primaryEndpoints.blob}${deploymentContainerName}'
              authentication: {
                type: 'UserAssignedIdentity'
                userAssignedIdentityResourceId: managedIdentity.outputs.resourceId
              }
            }
          }
          runtime: { name: runtimeStack, version: flexRuntimeVersion }
          scaleAndConcurrency: {
            maximumInstanceCount: flexMaximumInstanceCount
            instanceMemoryMB: flexInstanceMemoryMB
          }
        }
      : null
    configs: [
      {
        name: 'appsettings'
        storageAccountResourceId: storageAccount.id
        storageAccountUseIdentityAuthentication: true
        applicationInsightResourceId: appInsights.outputs.resourceId
        properties: customAppSettings
      }
    ]
    autoGeneratedDomainNameLabelScope: autoGeneratedDomainNameLabelScope
  }
}

// ===========================================================================
// Outputs
// ===========================================================================
output functionAppName string = functionApp.outputs.name
output functionAppResourceId string = functionApp.outputs.resourceId
output defaultHostname string = functionApp.outputs.defaultHostname
output storageAccountName string = storageAccount.name
output appInsightsResourceId string = appInsights.outputs.resourceId
output appServicePlanResourceId string = appServicePlan.outputs.resourceId
output managedIdentityResourceId string = managedIdentity.outputs.resourceId
