{
    "name": "vscode-azure",
    "version": "0.1.0",
    "private": true,
    "publisher": "ms-azuretools",
    "displayName": "Azure for Visual Studio Code",
    "description": "%extension.description%",
    "homepage": "https://github.com/microsoft/vscode-azure#readme",
    "bugs": {
        "url": "https://github.com/microsoft/vscode-azure/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/microsoft/vscode-azure.git"
    },
    "license": "MIT",
    "author": "Microsoft Corporation",
    "main": "main.mjs",
    "module": "main.mjs",
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "commands": [
            {
                "command": "azure.hello",
                "category": "Azure",
                "title": "Hello World!"
            },
            {
                "command": "vscode-azure/resources/refresh",
                "icon": "$(refresh)",
                "title": "%commands.vscode-azure/resources/refresh%"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "vscode-azure/resources/refresh",
                    "when": "false"
                }
            ],
            "view/title": [
                {
                    "command": "vscode-azure/resources/refresh",
                    "when": "view == vscode-azure/resources",
                    "group": "navigation"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "title": "%viewContainers.vscode-azure%",
                    "icon": "$(azure)",
                    "id": "vscode-azure"
                }
            ]
        },
        "views": {
            "vscode-azure": [
                {
                    "name": "%views.vscode-azure/resources%",
                    "id": "vscode-azure/resources",
                    "icon": "$(azure)",
                    "visibility": "visible",
                    "type": "tree"
                }
            ]
        }
    },
    "scripts": {
        "lint": "eslint --max-warnings 0",
        "build": "npm run build:esbuild & npm run build:check",
        "build:esbuild": "node esbuild.mjs",
        "build:check": "tsc --noEmit",
        "package": "vsce package",
        "test": "vscode-test"
    },
    "engines": {
        "vscode": "^1.106.0"
    },
    "devDependencies": {
        "@microsoft/vscode-azext-azureauth": "*",
        "@types/vscode": "1.106.0",
        "@vscode/test-cli": "*",
        "@vscode/test-electron": "*",
        "@vscode/vsce": "*",
        "esbuild": "*",
        "esbuild-plugin-copy": "*"
    },
    "dependencies": {
        "@microsoft/vscode-azure-azutils": "*",
        "@microsoft/vscode-azure-utils": "*",
        "inversify": "^7.11.0",
        "reflect-metadata": "^0.2.2"
    }
}
