{
    "name": "vscode-azure",
    "version": "1.0.0",
    "private": true,
    "publisher": "ms-azuretools",
    "displayName": "Azure for Visual Studio Code",
    "description": "%extension.description%",
    "homepage": "https://github.com/microsoft/vscode-azure#readme",
    "bugs": {
        "url": "https://github.com/microsoft/vscode-azure/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/microsoft/vscode-azure.git"
    },
    "license": "MIT",
    "author": "Microsoft Corporation",
    "main": "main.js",
    "activationEvents": [
        "onDebugDynamicConfigurations",
        "onDebugInitialConfigurations",
        "onDebugResolve:pwa-chrome",
        "workspaceContains:**/staticwebapp.config.json",
        "workspaceContains:**/swa-cli.config.json"
    ],
    "capabilities": {
        "virtualWorkspaces": {
            "supported": "limited",
            "description": "%capabilities.virtualWorkspaces.description%"
        }
    },
    "contributes": {
        "debuggers": [
            {
                "type": "swa",
                "label": "%debuggers.vscode-azure/staticWebApps/swa%"
            }
        ],
        "commands": [
            {
                "command": "vscode-azure/resources/refresh",
                "icon": "$(refresh)",
                "title": "%commands.vscode-azure/resources/refresh%"
            },
            {
                "command": "vscode-azure/workspace/refresh",
                "icon": "$(refresh)",
                "title": "%commands.vscode-azure/workspace/refresh%"
            },
            {
                "command": "vscode-azure/workspace/revealInExplorer",
                "title": "%commands.vscode-azure/workspace/revealInExplorer%"
            },
            {
                "command": "vscode-azure/resources/openInPortal",
                "icon": "$(link-external)",
                "title": "%commands.vscode-azure/resources/openInPortal%"
            },
            {
                "command": "vscode-azure/resources/delete",
                "icon": "$(trash)",
                "title": "%commands.vscode-azure/resources/delete%"
            },
            {
                "command": "vscode-azure/resourceGroups/delete",
                "icon": "$(trash)",
                "title": "%commands.vscode-azure/resourceGroups/delete%"
            },
            {
                "command": "vscode-azure/resources/browseWebsite",
                "icon": "$(globe)",
                "title": "%commands.vscode-azure/resources/browseWebsite%"
            },
            {
                "command": "vscode-azure/installAzd",
                "category": "%commands.category.azure%",
                "title": "%commands.vscode-azure/installAzd%"
            },
            {
                "command": "vscode-azure/acr/disableAdminUser",
                "category": "%commands.category.azure%",
                "title": "Disable Admin User"
            },
            {
                "command": "vscode-azure/resources/loadMore",
                "title": "%commands.vscode-azure/resources/loadMore%"
            },
            {
                "command": "vscode-azure/resources/groupBy",
                "icon": "$(group-by-ref-type)",
                "title": "%commands.vscode-azure/resources/groupBy%"
            },
            {
                "command": "vscode-azure/activity/clearSuccessful",
                "icon": "$(check)",
                "title": "%commands.vscode-azure/activity/clearSuccessful%"
            },
            {
                "command": "vscode-azure/activity/clearCompleted",
                "icon": "$(check-all)",
                "title": "%commands.vscode-azure/activity/clearCompleted%"
            },
            {
                "command": "vscode-azure/activity/clearAll",
                "icon": "$(clear-all)",
                "title": "%commands.vscode-azure/activity/clearAll%"
            },
            {
                "command": "vscode-azure/settings/edit",
                "icon": "$(edit)",
                "title": "%commands.vscode-azure/settings/edit%"
            },
            {
                "command": "vscode-azure/functions/createNew",
                "category": "%commands.category.azure%",
                "title": "%commands.vscode-azure/functions/createNew%"
            },
            {
                "command": "vscode-azure/functions/deploy",
                "category": "%commands.category.azure%",
                "title": "%commands.vscode-azure/functions/deploy%"
            },
            {
                "command": "vscode-azure/staticWebApps/createNew",
                "category": "%commands.category.azureStaticWebApps%",
                "icon": "$(add)",
                "title": "%commands.vscode-azure/staticWebApps/createNew%"
            },
            {
                "command": "vscode-azure/staticWebApps/createAdvanced",
                "category": "%commands.category.azureStaticWebApps%",
                "icon": "$(settings-gear)",
                "title": "%commands.vscode-azure/staticWebApps/createAdvanced%"
            },
            {
                "command": "vscode-azure/staticWebApps/browse",
                "category": "%commands.category.azureStaticWebApps%",
                "icon": "$(globe)",
                "title": "%commands.vscode-azure/staticWebApps/browse%"
            },
            {
                "command": "vscode-azure/staticWebApps/deleteEnvironment",
                "category": "%commands.category.azureStaticWebApps%",
                "icon": "$(trash)",
                "title": "%commands.vscode-azure/staticWebApps/deleteEnvironment%"
            },
            {
                "command": "vscode-azure/staticWebApps/deploy",
                "category": "%commands.category.azureStaticWebApps%",
                "enablement": "!virtualWorkspace",
                "icon": "$(cloud-upload)",
                "title": "%commands.vscode-azure/staticWebApps/deploy%"
            },
            {
                "command": "vscode-azure/staticWebApps/createSwaConfigFile",
                "category": "%commands.category.azureStaticWebApps%",
                "enablement": "!isWeb",
                "icon": "$(new-file)",
                "title": "%commands.vscode-azure/staticWebApps/createSwaConfigFile%"
            },
            {
                "command": "vscode-azure/staticWebApps/showDocumentation",
                "category": "%commands.category.azureStaticWebApps%",
                "icon": "$(book)",
                "title": "%commands.vscode-azure/staticWebApps/showDocumentation%"
            },
            {
                "command": "vscode-azure/staticWebApps/showFunctionsDocumentation",
                "category": "%commands.category.azureStaticWebApps%",
                "icon": "$(book)",
                "title": "%commands.vscode-azure/staticWebApps/showFunctionsDocumentation%"
            },
            {
                "command": "vscode-azure/staticWebApps/viewProperties",
                "category": "%commands.category.azureStaticWebApps%",
                "icon": "$(list-tree)",
                "title": "%commands.vscode-azure/staticWebApps/viewProperties%"
            },
            {
                "command": "vscode-azure/staticWebApps/installOrUpdateCli",
                "category": "%commands.category.azureStaticWebApps%",
                "enablement": "!virtualWorkspace",
                "icon": "$(terminal)",
                "title": "%commands.vscode-azure/staticWebApps/installOrUpdateCli%"
            },
            {
                "command": "vscode-azure/staticWebApps/uninstallCli",
                "category": "%commands.category.azureStaticWebApps%",
                "enablement": "!virtualWorkspace",
                "icon": "$(trash)",
                "title": "%commands.vscode-azure/staticWebApps/uninstallCli%"
            },
            {
                "command": "vscode-azure/azdUp",
                "category": "%commands.category.azure%",
                "icon": "$(rocket)",
                "title": "%commands.vscode-azure/azdUp%"
            },
            {
                "command": "vscode-azure/azdDown",
                "category": "%commands.category.azure%",
                "icon": "$(trash)",
                "title": "%commands.vscode-azure/azdDown%"
            },
            {
                "command": "vscode-azure/signIn",
                "category": "%commands.category.azure%",
                "icon": "$(sign-in)",
                "title": "%commands.vscode-azure/signIn%"
            },
            {
                "command": "vscode-azure/selectSubscriptions",
                "category": "%commands.category.azure%",
                "icon": "$(filter)",
                "title": "%commands.vscode-azure/selectSubscriptions%"
            }
        ],
        "submenus": [
            {
                "id": "vscode-azure/staticWebApps/workspaceActions",
                "label": "%submenus.vscode-azure/staticWebApps/workspaceActions%",
                "icon": {
                    "light": "dist/azureIcons/microsoft.web/staticsites.svg",
                    "dark": "dist/azureIcons/microsoft.web/staticsites.svg"
                }
            }
        ],
        "menus": {
            "vscode-azure/staticWebApps/workspaceActions": [
                {
                    "command": "vscode-azure/staticWebApps/createSwaConfigFile",
                    "group": "1_project@1"
                },
                {
                    "command": "vscode-azure/staticWebApps/createNew",
                    "group": "2_create@1"
                },
                {
                    "command": "vscode-azure/staticWebApps/createAdvanced",
                    "group": "2_create@2"
                }
            ],
            "commandPalette": [
                {
                    "command": "vscode-azure/resources/refresh",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/workspace/refresh",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/workspace/revealInExplorer",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/acr/disableAdminUser",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/resources/openInPortal",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/resources/delete",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/resourceGroups/delete",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/resources/browseWebsite",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/resources/loadMore",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/resources/groupBy",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/activity/clearSuccessful",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/activity/clearCompleted",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/activity/clearAll",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/settings/edit",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/staticWebApps/deleteEnvironment",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/staticWebApps/showFunctionsDocumentation",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/staticWebApps/viewProperties",
                    "when": "false"
                }
            ],
            "view/title": [
                {
                    "command": "vscode-azure/resources/groupBy",
                    "when": "view == vscode-azure/resources",
                    "group": "navigation@1"
                },
                {
                    "command": "vscode-azure/selectSubscriptions",
                    "when": "view == vscode-azure/resources",
                    "group": "navigation@2"
                },
                {
                    "command": "vscode-azure/resources/refresh",
                    "when": "view == vscode-azure/resources",
                    "group": "navigation@3"
                },
                {
                    "command": "vscode-azure/workspace/refresh",
                    "when": "view == vscode-azure/workspace",
                    "group": "navigation@1"
                },
                {
                    "submenu": "vscode-azure/staticWebApps/workspaceActions",
                    "when": "view == vscode-azure/workspace",
                    "group": "navigation@3"
                },
                {
                    "command": "vscode-azure/activity/clearSuccessful",
                    "when": "view == vscode-azure/activity",
                    "group": "navigation@1"
                },
                {
                    "command": "vscode-azure/activity/clearCompleted",
                    "when": "view == vscode-azure/activity",
                    "group": "navigation@2"
                },
                {
                    "command": "vscode-azure/activity/clearAll",
                    "when": "view == vscode-azure/activity",
                    "group": "navigation@3"
                }
            ],
            "view/item/context": [
                {
                    "command": "vscode-azure/acr/disableAdminUser",
                    "when": "view == vscode-azure/resources && viewItem =~ /\\bdisableAcrAdminUser\\b/i"
                },
                {
                    "command": "vscode-azure/resources/openInPortal",
                    "when": "view == vscode-azure/resources && viewItem =~ /\\bopenInPortal\\b/i"
                },
                {
                    "command": "vscode-azure/resources/delete",
                    "when": "view == vscode-azure/resources && viewItem =~ /\\bdeleteResource\\b/i"
                },
                {
                    "command": "vscode-azure/resourceGroups/delete",
                    "when": "view == vscode-azure/resources && viewItem =~ /\\bdeleteResourceGroup\\b/i"
                },
                {
                    "command": "vscode-azure/resources/browseWebsite",
                    "when": "view == vscode-azure/resources && viewItem =~ /\\bbrowseWebsite\\b/i"
                },
                {
                    "command": "vscode-azure/settings/edit",
                    "when": "view == vscode-azure/resources && viewItem =~ /\\beditSettings\\b/i",
                    "group": "inline@1"
                },
                {
                    "command": "vscode-azure/staticWebApps/createNew",
                    "when": "view == vscode-azure/resources && viewItem =~ /\\bStaticWebApps\\b/i && viewItem =~ /\\bazureResourceTypeGroup\\b/i",
                    "group": "1@1"
                },
                {
                    "command": "vscode-azure/staticWebApps/createAdvanced",
                    "when": "view == vscode-azure/resources && viewItem =~ /\\bStaticWebApps\\b/i && viewItem =~ /\\bazureResourceTypeGroup\\b/i",
                    "group": "1@2"
                },
                {
                    "command": "vscode-azure/staticWebApps/browse",
                    "when": "view == vscode-azure/resources && viewItem =~ /\\b(?:browseStaticWebApp|azureStaticWebApp|azureStaticEnvironment)\\b/i",
                    "group": "1@1"
                },
                {
                    "command": "vscode-azure/staticWebApps/deleteEnvironment",
                    "when": "view == vscode-azure/resources && viewItem =~ /\\b(?:deleteStaticWebAppEnvironment|azureStaticEnvironment)\\b/i",
                    "group": "3@2"
                },
                {
                    "command": "vscode-azure/staticWebApps/viewProperties",
                    "when": "view == vscode-azure/resources && viewItem =~ /\\b(?:viewStaticWebAppProperties|azureStaticEnvironment)\\b/i",
                    "group": "9@1"
                },
                {
                    "command": "vscode-azure/resources/refresh",
                    "when": "view == vscode-azure/resources && viewItem =~ /\\b(?:azureStaticEnvironment|azureStaticFunctions)\\b/i",
                    "group": "9@3"
                },
                {
                    "command": "vscode-azure/workspace/revealInExplorer",
                    "when": "view == vscode-azure/workspace && viewItem =~ /\\brevealInExplorer\\b/i",
                    "group": "navigation"
                }
            ],
            "explorer/context": [
                {
                    "command": "vscode-azure/azdUp",
                    "when": "resourceFilename =~ /^azure\\.ya?ml$/i",
                    "group": "navigation"
                },
                {
                    "command": "vscode-azure/azdDown",
                    "when": "resourceFilename =~ /^azure\\.ya?ml$/i",
                    "group": "navigation"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "title": "%viewContainers.vscode-azure%",
                    "icon": "$(azure)",
                    "id": "vscode-azure"
                }
            ],
            "panel": [
                {
                    "title": "%viewContainers.vscode-azure-panel%",
                    "icon": "$(azure)",
                    "id": "vscode-azure-panel"
                }
            ]
        },
        "views": {
            "vscode-azure": [
                {
                    "name": "%views.vscode-azure/resources%",
                    "id": "vscode-azure/resources",
                    "icon": "$(azure)",
                    "visibility": "visible",
                    "type": "tree"
                },
                {
                    "name": "%views.vscode-azure/workspace%",
                    "id": "vscode-azure/workspace",
                    "icon": "$(folder)",
                    "visibility": "visible",
                    "type": "tree"
                }
            ],
            "vscode-azure-panel": [
                {
                    "name": "%views.vscode-azure/activity%",
                    "id": "vscode-azure/activity",
                    "icon": "$(azure)",
                    "visibility": "collapsed",
                    "type": "tree"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "vscode-azure/resources",
                "contents": "%views.vscode-azure/resources.welcome%"
            }
        ],
        "configuration": {
            "title": "%settings.title%",
            "properties": {
                "vscode-azure.pageSize": {
                    "type": "integer",
                    "default": 50,
                    "minimum": 1,
                    "maximum": 1000,
                    "description": "%settings.vscode-azure.pageSize%"
                },
                "vscode-azure.alwaysShowAccountNodes": {
                    "type": "boolean",
                    "default": false,
                    "description": "%settings.vscode-azure.alwaysShowAccountNodes%"
                },
                "vscode-azure.groupBy": {
                    "type": "string",
                    "default": "resourceGroup",
                    "enum": [
                        "resourceGroup",
                        "resourceType",
                        "location",
                        "armTag"
                    ],
                    "enumDescriptions": [
                        "%settings.vscode-azure.groupBy.resourceGroup%",
                        "%settings.vscode-azure.groupBy.resourceType%",
                        "%settings.vscode-azure.groupBy.location%",
                        "%settings.vscode-azure.groupBy.armTag%"
                    ],
                    "description": "%settings.vscode-azure.groupBy%"
                },
                "vscode-azure.groupByTag": {
                    "type": "string",
                    "default": "",
                    "description": "%settings.vscode-azure.groupByTag%"
                },
                "vscode-azure.signedInTenants": {
                    "type": "array",
                    "default": [],
                    "items": {
                        "type": "object",
                        "properties": {
                            "accountId": {
                                "type": "string"
                            },
                            "tenantId": {
                                "type": "string",
                                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
                                "patternErrorMessage": "%settings.vscode-azure.signedInTenants.tenantId.patternError%"
                            }
                        },
                        "required": [
                            "accountId",
                            "tenantId"
                        ]
                    },
                    "scope": "machine-overridable",
                    "description": "%settings.vscode-azure.signedInTenants%"
                },
                "vscode-azure.selectedSubscriptions": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
                        "patternErrorMessage": "%settings.vscode-azure.selectedSubscriptions.patternError%"
                    },
                    "default": [],
                    "description": "%settings.vscode-azure.selectedSubscriptions%"
                },
                "vscode-azure.staticWebApps.appSubpath": {
                    "type": "string",
                    "scope": "resource",
                    "description": "%settings.vscode-azure.staticWebApps.appSubpath%"
                },
                "vscode-azure.staticWebApps.apiSubpath": {
                    "type": "string",
                    "scope": "resource",
                    "description": "%settings.vscode-azure.staticWebApps.apiSubpath%"
                },
                "vscode-azure.staticWebApps.outputSubpath": {
                    "type": "string",
                    "scope": "resource",
                    "description": "%settings.vscode-azure.staticWebApps.outputSubpath%"
                },
                "vscode-azure.staticWebApps.showStaticWebAppsCliWarning": {
                    "type": "boolean",
                    "default": true,
                    "description": "%settings.vscode-azure.staticWebApps.showStaticWebAppsCliWarning%"
                }
            }
        },
        "jsonValidation": [
            {
                "fileMatch": "staticwebapp.config.json",
                "url": "https://json.schemastore.org/staticwebapp.config.json"
            },
            {
                "fileMatch": "swa-cli.config.json",
                "url": "https://raw.githubusercontent.com/Azure/static-web-apps-cli/main/schema/swa-cli.config.schema.json"
            }
        ],
        "problemMatchers": [
            {
                "name": "swa-watch",
                "label": "%problemMatchers.vscode-azure/staticWebApps/swaWatch%",
                "owner": "swa",
                "source": "swa",
                "pattern": {
                    "regexp": ".",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Azure Static Web Apps emulator started"
                }
            }
        ]
    },
    "scripts": {
        "lint": "eslint --max-warnings 0 --cache",
        "build": "pnpm run --parallel \"/^build:(esbuild|check)$/\"",
        "build:esbuild": "node esbuild.mjs",
        "build:esbuild:watch": "pnpm run build:esbuild --watch",
        "build:check": "tsc --noEmit",
        "build:check:watch": "pnpm run build:check --watch",
        "package": "pnpx @vscode/vsce@latest package --no-dependencies",
        "test": "vscode-test",
        "testcov": "vscode-test --coverage",
        "clean": "node ../../scripts/clean.mjs"
    },
    "engines": {
        "vscode": "^1.123.0"
    },
    "devDependencies": {
        "@azure/identity": "^4.13.1",
        "@types/semver": "^7.7.1",
        "@vscode/test-cli": "catalog:",
        "@vscode/test-electron": "catalog:",
        "esbuild": "catalog:",
        "esbuild-plugin-copy": "catalog:",
        "tsx": "catalog:"
    },
    "dependencies": {
        "@azure/core-lro": "^3.4.0",
        "@microsoft/vscode-azure-azutils": "workspace:*",
        "@microsoft/vscode-azure-utils": "workspace:*",
        "@vscode/extension-telemetry": "catalog:",
        "inversify": "catalog:",
        "jsonc-parser": "^3.3.1",
        "semver": "^7.8.4",
        "yaml": "^2.8.1"
    }
}
