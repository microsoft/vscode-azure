{
    "name": "vscode-azure",
    "version": "1.0.0",
    "private": true,
    "publisher": "ms-azuretools",
    "displayName": "Azure for Visual Studio Code",
    "description": "%extension.description%",
    "homepage": "https://github.com/microsoft/vscode-azure#readme",
    "bugs": {
        "url": "https://github.com/microsoft/vscode-azure/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/microsoft/vscode-azure.git"
    },
    "license": "MIT",
    "author": "Microsoft Corporation",
    "main": "main.js",
    "contributes": {
        "commands": [
            {
                "command": "vscode-azure/resources/refresh",
                "icon": "$(refresh)",
                "title": "%commands.vscode-azure/resources/refresh%"
            },
            {
                "command": "vscode-azure/workspace/refresh",
                "icon": "$(refresh)",
                "title": "%commands.vscode-azure/workspace/refresh%"
            },
            {
                "command": "vscode-azure/workspace/revealInExplorer",
                "title": "%commands.vscode-azure/workspace/revealInExplorer%"
            },
            {
                "command": "vscode-azure/resources/openInPortal",
                "icon": "$(link-external)",
                "title": "%commands.vscode-azure/resources/openInPortal%"
            },
            {
                "command": "vscode-azure/installAzd",
                "category": "%commands.category.azure%",
                "title": "%commands.vscode-azure/installAzd%"
            },
            {
                "command": "vscode-azure/acr/disableAdminUser",
                "category": "%commands.category.azure%",
                "title": "Disable Admin User"
            },
            {
                "command": "vscode-azure/resources/loadMore",
                "title": "%commands.vscode-azure/resources/loadMore%"
            },
            {
                "command": "vscode-azure/resources/groupBy",
                "icon": "$(group-by-ref-type)",
                "title": "%commands.vscode-azure/resources/groupBy%"
            },
            {
                "command": "vscode-azure/activity/clearSuccessful",
                "icon": "$(check)",
                "title": "%commands.vscode-azure/activity/clearSuccessful%"
            },
            {
                "command": "vscode-azure/activity/clearCompleted",
                "icon": "$(check-all)",
                "title": "%commands.vscode-azure/activity/clearCompleted%"
            },
            {
                "command": "vscode-azure/activity/clearAll",
                "icon": "$(clear-all)",
                "title": "%commands.vscode-azure/activity/clearAll%"
            },
            {
                "command": "vscode-azure/functionApp/appSettings/add",
                "icon": "$(add)",
                "title": "%commands.vscode-azure/functionApp/appSettings/add%"
            },
            {
                "command": "vscode-azure/functionApp/appSettings/edit",
                "icon": "$(edit)",
                "title": "%commands.vscode-azure/functionApp/appSettings/edit%"
            },
            {
                "command": "vscode-azure/functionApp/appSettings/delete",
                "icon": "$(trash)",
                "title": "%commands.vscode-azure/functionApp/appSettings/delete%"
            },
            {
                "command": "vscode-azure/functions/createNew",
                "category": "%commands.category.azure%",
                "title": "%commands.vscode-azure/functions/createNew%"
            },
            {
                "command": "vscode-azure/functions/deploy",
                "category": "%commands.category.azure%",
                "title": "%commands.vscode-azure/functions/deploy%"
            },
            {
                "command": "vscode-azure/azdUp",
                "category": "%commands.category.azure%",
                "icon": "$(rocket)",
                "title": "%commands.vscode-azure/azdUp%"
            },
            {
                "command": "vscode-azure/azdDown",
                "category": "%commands.category.azure%",
                "icon": "$(trash)",
                "title": "%commands.vscode-azure/azdDown%"
            },
            {
                "command": "vscode-azure/signIn",
                "category": "%commands.category.azure%",
                "icon": "$(sign-in)",
                "title": "%commands.vscode-azure/signIn%"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "vscode-azure/resources/refresh",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/workspace/refresh",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/workspace/revealInExplorer",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/acr/disableAdminUser",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/resources/openInPortal",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/resources/loadMore",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/resources/groupBy",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/activity/clearSuccessful",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/activity/clearCompleted",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/activity/clearAll",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/functionApp/appSettings/add",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/functionApp/appSettings/edit",
                    "when": "false"
                },
                {
                    "command": "vscode-azure/functionApp/appSettings/delete",
                    "when": "false"
                }
            ],
            "view/title": [
                {
                    "command": "vscode-azure/resources/groupBy",
                    "when": "view == vscode-azure/resources",
                    "group": "navigation@1"
                },
                {
                    "command": "vscode-azure/resources/refresh",
                    "when": "view == vscode-azure/resources",
                    "group": "navigation@2"
                },
                {
                    "command": "vscode-azure/workspace/refresh",
                    "when": "view == vscode-azure/workspace",
                    "group": "navigation@1"
                },
                {
                    "command": "vscode-azure/activity/clearSuccessful",
                    "when": "view == vscode-azure/activity",
                    "group": "navigation@1"
                },
                {
                    "command": "vscode-azure/activity/clearCompleted",
                    "when": "view == vscode-azure/activity",
                    "group": "navigation@2"
                },
                {
                    "command": "vscode-azure/activity/clearAll",
                    "when": "view == vscode-azure/activity",
                    "group": "navigation@3"
                }
            ],
            "view/item/context": [
                {
                    "command": "vscode-azure/acr/disableAdminUser",
                    "when": "view == vscode-azure/resources && viewItem =~ /\\bdisableAcrAdminUser\\b/i"
                },
                {
                    "command": "vscode-azure/resources/openInPortal",
                    "when": "view == vscode-azure/resources && viewItem =~ /\\bopenInPortal\\b/i"
                },
                {
                    "command": "vscode-azure/functionApp/appSettings/add",
                    "when": "view == vscode-azure/resources && viewItem =~ /\\baddFunctionAppSetting\\b/i"
                },
                {
                    "command": "vscode-azure/functionApp/appSettings/edit",
                    "when": "view == vscode-azure/resources && viewItem =~ /\\beditFunctionAppSetting\\b/i"
                },
                {
                    "command": "vscode-azure/functionApp/appSettings/delete",
                    "when": "view == vscode-azure/resources && viewItem =~ /\\bdeleteFunctionAppSetting\\b/i"
                },
                {
                    "command": "vscode-azure/workspace/revealInExplorer",
                    "when": "view == vscode-azure/workspace && viewItem =~ /\\brevealInExplorer\\b/i",
                    "group": "navigation"
                }
            ],
            "explorer/context": [
                {
                    "command": "vscode-azure/azdUp",
                    "when": "resourceFilename =~ /^azure\\.ya?ml$/i",
                    "group": "navigation"
                },
                {
                    "command": "vscode-azure/azdDown",
                    "when": "resourceFilename =~ /^azure\\.ya?ml$/i",
                    "group": "navigation"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "title": "%viewContainers.vscode-azure%",
                    "icon": "$(azure)",
                    "id": "vscode-azure"
                }
            ],
            "panel": [
                {
                    "title": "%viewContainers.vscode-azure-panel%",
                    "icon": "$(azure)",
                    "id": "vscode-azure-panel"
                }
            ]
        },
        "views": {
            "vscode-azure": [
                {
                    "name": "%views.vscode-azure/resources%",
                    "id": "vscode-azure/resources",
                    "icon": "$(azure)",
                    "visibility": "visible",
                    "type": "tree"
                },
                {
                    "name": "%views.vscode-azure/workspace%",
                    "id": "vscode-azure/workspace",
                    "icon": "$(folder)",
                    "visibility": "visible",
                    "type": "tree"
                }
            ],
            "vscode-azure-panel": [
                {
                    "name": "%views.vscode-azure/activity%",
                    "id": "vscode-azure/activity",
                    "icon": "$(azure)",
                    "visibility": "collapsed",
                    "type": "tree"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "vscode-azure/resources",
                "contents": "%views.vscode-azure/resources.welcome%"
            }
        ],
        "configuration": {
            "title": "%settings.title%",
            "properties": {
                "vscode-azure.pageSize": {
                    "type": "integer",
                    "default": 50,
                    "minimum": 1,
                    "maximum": 1000,
                    "description": "%settings.vscode-azure.pageSize%"
                },
                "vscode-azure.alwaysShowAccountNodes": {
                    "type": "boolean",
                    "default": false,
                    "description": "%settings.vscode-azure.alwaysShowAccountNodes%"
                },
                "vscode-azure.groupBy": {
                    "type": "string",
                    "default": "resourceGroup",
                    "enum": [
                        "resourceGroup",
                        "resourceType",
                        "location",
                        "armTag"
                    ],
                    "enumDescriptions": [
                        "%settings.vscode-azure.groupBy.resourceGroup%",
                        "%settings.vscode-azure.groupBy.resourceType%",
                        "%settings.vscode-azure.groupBy.location%",
                        "%settings.vscode-azure.groupBy.armTag%"
                    ],
                    "description": "%settings.vscode-azure.groupBy%"
                },
                "vscode-azure.groupByTag": {
                    "type": "string",
                    "default": "",
                    "description": "%settings.vscode-azure.groupByTag%"
                }
            }
        }
    },
    "scripts": {
        "lint": "eslint --max-warnings 0",
        "build": "pnpm run --parallel \"/^build:(esbuild|check)$/\"",
        "build:esbuild": "node esbuild.mjs",
        "build:check": "tsgo --noEmit",
        "package": "vsce package --no-dependencies",
        "test": "vscode-test",
        "testcov": "vscode-test --coverage",
        "clean": "node ../../scripts/clean.mjs"
    },
    "engines": {
        "vscode": "^1.123.0"
    },
    "devDependencies": {
        "@types/semver": "^7.7.1",
        "@vscode/test-cli": "catalog:",
        "@vscode/test-electron": "catalog:",
        "@vscode/vsce": "catalog:",
        "esbuild": "catalog:",
        "esbuild-plugin-copy": "catalog:",
        "tsx": "catalog:"
    },
    "dependencies": {
        "@microsoft/vscode-azure-azutils": "workspace:*",
        "@microsoft/vscode-azure-utils": "workspace:*",
        "@microsoft/vscode-processutils": "catalog:",
        "@vscode/extension-telemetry": "catalog:",
        "inversify": "catalog:",
        "semver": "^7.8.4"
    }
}
