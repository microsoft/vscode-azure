.gitignore
# Both entries are needed: `.vscode-test/**` covers the contents, while the bare `.vscode-test`
# covers the entry itself, which `pnpm run link-test-cache` creates as a junction. Without it,
# `vsce package` treats the junction as a file and fails to read it (EISDIR).
.vscode-test
.vscode-test/**
.vscode/**
