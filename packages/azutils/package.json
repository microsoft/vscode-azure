{
    "name": "@microsoft/vscode-azure-azutils",
    "version": "1.0.0",
    "private": true,
    "description": "Azure utils for Azure for Visual Studio Code",
    "homepage": "https://github.com/microsoft/vscode-azure#readme",
    "bugs": {
        "url": "https://github.com/microsoft/vscode-azure/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/microsoft/vscode-azure.git"
    },
    "license": "MIT",
    "author": "Microsoft Corporation",
    "type": "module",
    "module": "dist/esm/src/index.js",
    "types": "dist/esm/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/esm/src/index.d.ts",
            "import": "./dist/esm/src/index.js"
        },
        "./testing": {
            "types": "./dist/esm/src/testing.d.ts",
            "import": "./dist/esm/src/testing.js"
        }
    },
    "scripts": {
        "lint": "eslint --max-warnings 0",
        "build": "tsc",
        "package": "pnpm pack",
        "test": "mocha",
        "testcov": "pnpx c8 --clean --reporter=html --exclude=\"**/test/**\" mocha",
        "clean": "node ../../scripts/clean.mjs"
    },
    "dependencies": {
        "@azure/arm-appservice": "^19.0.0",
        "@azure/arm-containerregistry": "^12.0.0",
        "@azure/arm-resources": "beta",
        "@azure/arm-resources-subscriptions": "beta",
        "@azure/arm-resourcesdeployments": "beta",
        "@azure/logger": "^1.3.0",
        "@microsoft/vscode-azure-utils": "workspace:^"
    },
    "devDependencies": {
        "@azure-rest/core-client": "^2.6.1",
        "@azure/core-auth": "^1.10.1",
        "@azure/core-paging": "^1.6.2",
        "@azure/core-rest-pipeline": "^1.24.0",
        "inversify": "catalog:"
    },
    "mocha": {
        "node-option": [
            "experimental-transform-types",
            "import=@microsoft/vscode-azext-eng/mocha"
        ],
        "spec": [
            "test/**/*.test.ts"
        ]
    }
}
