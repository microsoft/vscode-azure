{
    "name": "@microsoft/vscode-azure-azutils",
    "version": "1.0.0",
    "private": true,
    "description": "Azure utils for Azure for Visual Studio Code",
    "homepage": "https://github.com/microsoft/vscode-azure#readme",
    "bugs": {
        "url": "https://github.com/microsoft/vscode-azure/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/microsoft/vscode-azure.git"
    },
    "license": "MIT",
    "author": "Microsoft Corporation",
    "type": "module",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "import": "./dist/esm/index.js"
        },
        "./testing": {
            "types": "./dist/esm/testing.d.ts",
            "import": "./dist/esm/testing.js"
        }
    },
    "scripts": {
        "lint": "eslint --max-warnings 0",
        "build": "tsgo",
        "package": "npm pack",
        "test": "mocha",
        "testcov": "npx c8 --reporter=html --exclude=\"**/test/**\" mocha",
        "clean": "node ../../scripts/clean.mjs"
    },
    "dependencies": {
        "@azure/arm-appservice": "^18.0.0",
        "@azure/arm-containerregistry": "12.0.0-alpha.20260224.1",
        "@azure/arm-resources": "^7.0.0",
        "@azure/arm-resources-subscriptions": "^2.1.0",
        "@azure/arm-resourcesdeployments": "^1.0.0-alpha.20250716.1",
        "@azure/logger": "^1.3.0",
        "@azure/ms-rest-azure-env": "^2.0.0",
        "@microsoft/vscode-azure-utils": "^1.0.0"
    },
    "devDependencies": {
        "@azure-rest/core-client": "*",
        "@azure/core-auth": "*",
        "@azure/core-client": "*",
        "@azure/core-paging": "*",
        "@azure/core-rest-pipeline": "*",
        "@microsoft/vscode-azext-azureauth": "*",
        "inversify": "*"
    },
    "mocha": {
        "node-option": [
            "experimental-transform-types",
            "disable-warning=ExperimentalWarning",
            "import=../../scripts/register-hooks.mjs"
        ],
        "spec": [
            "src/test/**/*.test.ts"
        ]
    }
}
