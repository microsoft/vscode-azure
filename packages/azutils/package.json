{
    "name": "@microsoft/vscode-azure-azutils",
    "version": "1.0.0",
    "private": true,
    "description": "Azure utils for Azure Tools for Visual Studio Code (preview)",
    "homepage": "https://github.com/microsoft/vscode-azure#readme",
    "bugs": {
        "url": "https://github.com/microsoft/vscode-azure/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/microsoft/vscode-azure.git"
    },
    "license": "MIT",
    "author": "Microsoft Corporation",
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "files": [
        "LICENSE.md",
        "dist",
        "resources",
        "!*.test.*",
        "!*.map",
        "!*.tsbuildinfo"
    ],
    "module": "dist/esm/src/index.js",
    "types": "dist/esm/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/esm/src/index.d.ts",
            "import": "./dist/esm/src/index.js"
        },
        "./testing": {
            "types": "./dist/esm/test/testing.d.ts",
            "import": "./dist/esm/test/testing.js"
        }
    },
    "scripts": {
        "lint": "eslint --max-warnings 0 --cache",
        "build": "tsc",
        "build:watch": "pnpm run build --watch",
        "package": "pnpm pack",
        "test": "mocha",
        "testcov": "pnpx c8 --clean --reporter=html --exclude=\"**/test/**\" mocha",
        "clean": "node ../../scripts/clean.mjs"
    },
    "dependencies": {
        "@azure/arm-appcontainers": "^4.0.0",
        "@azure/arm-appservice": "^19.0.0",
        "@azure/arm-containerregistry": "^12.0.0",
        "@azure/arm-resources": "^8.0.0",
        "@azure/arm-resources-subscriptions": "^3.0.0",
        "@azure/arm-resourcesdeployments": "^2.0.0",
        "@azure/logger": "^1.4.0",
        "@microsoft/vscode-azure-utils": "workspace:^"
    },
    "devDependencies": {
        "@azure-rest/core-client": "^2.9.0",
        "@azure/core-auth": "^1.11.0",
        "@azure/core-paging": "^1.7.0",
        "@azure/core-rest-pipeline": "^1.25.0",
        "inversify": "catalog:"
    }
}
