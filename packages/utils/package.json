{
    "name": "@microsoft/vscode-azure-utils",
    "version": "0.1.0",
    "private": true,
    "description": "Utils for Azure for Visual Studio Code",
    "homepage": "https://github.com/microsoft/vscode-azure#readme",
    "bugs": {
        "url": "https://github.com/microsoft/vscode-azure/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/microsoft/vscode-azure.git"
    },
    "license": "MIT",
    "author": "Microsoft Corporation",
    "type": "module",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "import": "./dist/esm/index.js"
        },
        "./testing": {
            "types": "./dist/esm/testing.d.ts",
            "import": "./dist/esm/testing.js"
        }
    },
    "scripts": {
        "lint": "eslint --max-warnings 0",
        "build": "tsgo",
        "package": "npm pack",
        "test": "mocha",
        "testcov": "npx nyc --reporter=html mocha"
    },
    "dependencies": {
        "@vscode/extension-telemetry": "^1.5.0"
    },
    "mocha": {
        "node-option": [
            "import=tsx"
        ],
        "spec": [
            "src/test/**/*.test.ts"
        ]
    },
    "devDependencies": {
        "inversify": "^7.11.0"
    }
}
