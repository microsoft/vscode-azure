{
    "name": "@microsoft/vscode-azure-utils",
    "version": "1.0.0",
    "private": true,
    "description": "Utils for Azure for Visual Studio Code",
    "homepage": "https://github.com/microsoft/vscode-azure#readme",
    "bugs": {
        "url": "https://github.com/microsoft/vscode-azure/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/microsoft/vscode-azure.git"
    },
    "license": "MIT",
    "author": "Microsoft Corporation",
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "files": [
        "LICENSE.md",
        "dist",
        "!*.test.*",
        "!*.map",
        "!*.tsbuildinfo"
    ],
    "module": "dist/esm/src/index.js",
    "types": "dist/esm/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/esm/src/index.d.ts",
            "import": "./dist/esm/src/index.js"
        },
        "./testing": {
            "types": "./dist/esm/test/testing.d.ts",
            "import": "./dist/esm/test/testing.js"
        }
    },
    "scripts": {
        "lint": "eslint --max-warnings 0 --cache",
        "build": "tsc",
        "build:watch": "pnpm run build --watch",
        "package": "pnpm pack",
        "test": "mocha",
        "testcov": "pnpx c8 --clean --reporter=html --exclude=\"**/test/**\" mocha",
        "clean": "node ../../scripts/clean.mjs"
    },
    "dependencies": {
        "@azure/core-process": "^1.0.0",
        "minimatch": "^10.2.6",
        "vscode-uri": "catalog:"
    },
    "devDependencies": {
        "@vscode/extension-telemetry": "catalog:",
        "inversify": "catalog:"
    }
}
