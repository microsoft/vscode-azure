{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Extension: ESBuild+Watch",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "--workspace=extensions/vscode-azure",
                "build:esbuild",
                "--",
                "--watch"
            ],
            "problemMatcher": "$esbuild-watch",
            "presentation": {
                "reveal": "silent",
            },
            "group": {
                "kind": "build",
            },
            "isBackground": true,
        },
        {
            "label": "Extension: Check+Watch",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "--workspace=extensions/vscode-azure",
                "build:check",
                "--",
                "--watch"
            ],
            "problemMatcher": {
                "base": "$tsgo-watch",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/extensions/vscode-azure"
                ]
            },
            "presentation": {
                "revealProblems": "onProblem",
            },
            "group": {
                "kind": "build",
                "isDefault": true,
            },
            "isBackground": true,
        },
        {
            "label": "azutils: Build+Watch",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "--workspace=packages/azutils",
                "build",
                "--",
                "--watch",
            ],
            "group": {
                "kind": "build"
            },
            "isBackground": true,
            "presentation": {
                "revealProblems": "onProblem"
            },
            "problemMatcher": {
                "base": "$tsgo-watch",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/packages/azutils"
                ]
            },
        },
        {
            "label": "utils: Build+Watch",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "--workspace=packages/utils",
                "build",
                "--",
                "--watch",
            ],
            "group": {
                "kind": "build"
            },
            "isBackground": true,
            "presentation": {
                "revealProblems": "onProblem"
            },
            "problemMatcher": {
                "base": "$tsgo-watch",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/packages/utils"
                ]
            },
        },
    ]
}
