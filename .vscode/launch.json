// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Extension: Run",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/extensions/vscode-azure",
                "--disable-extension",
                "ms-azuretools.vscode-azureresourcegroups", // This extension replaces Azure Resources, so disable it to avoid conflicts
            ],
            "env": {
                "DEBUGTELEMETRY": "1",
            },
            "outFiles": [
                "${workspaceFolder}/extensions/vscode-azure/dist/**/*.{js,mjs,cjs}",
            ],
            "preLaunchTask": "Extension: ESBuild+Watch",
        },
        {
            "name": "Extension: Run (Mock Data)",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/extensions/vscode-azure",
                "--disable-extension",
                "ms-azuretools.vscode-azureresourcegroups",
            ],
            "env": {
                "DEBUGTELEMETRY": "1",
                "AZURE_MOCK_DATA": "1",
            },
            "outFiles": [
                "${workspaceFolder}/extensions/vscode-azure/dist/**/*.{js,mjs,cjs}",
            ],
            "preLaunchTask": "Extension: ESBuild+Watch",
        },
        {
            "name": "Extension: Run Tests",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--disable-extension",
                "ms-azuretools.vscode-azureresourcegroups", // This extension replaces Azure Resources, so disable it to avoid conflicts
                "--disable-extension",
                "github.copilot-chat", // GitHub Copilot Chat throws a lot of spurious errors when we rapidly launch then close during tests
            ],
            "testConfiguration": "${workspaceFolder}/extensions/vscode-azure/.vscode-test.mjs",
            "env": {
                "DEBUGTELEMETRY": "1",
                "TSX_TSCONFIG_PATH": "${workspaceFolder}/extensions/vscode-azure/tsconfig.json", // Necessary only for F5 to get tsx to allow decorators
            },
            "outFiles": [
                "${workspaceFolder}/extensions/vscode-azure/dist/**/*.{js,mjs,cjs}",
                "${workspaceFolder}/extensions/vscode-azure/src/**/*.{ts,mts,cts}", // We are using TSX so out files *are* the source files
            ],
            "preLaunchTask": "Extension: ESBuild+Watch",
        },
        {
            "name": "azutils: Run Tests",
            "request": "launch",
            "runtimeArgs": [
                "run",
                "--workspace=packages/azutils",
                "test"
            ],
            "runtimeExecutable": "npm",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },
        {
            "name": "utils: Run Tests",
            "request": "launch",
            "runtimeArgs": [
                "run",
                "--workspace=packages/utils",
                "test"
            ],
            "runtimeExecutable": "npm",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },
    ],
}
